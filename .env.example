# ---- Chain ----------------------------------------------------------------
NEXT_PUBLIC_CHAIN_ID=4663
NEXT_PUBLIC_CHAIN_NAME=Robinhood Chain
NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.chain.robinhood.com
NEXT_PUBLIC_EXPLORER_URL=https://robinhoodchain.blockscout.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ---- The game token (the CA) — the one thing the operator provides -------
NEXT_PUBLIC_TOKEN_ADDRESS=
NEXT_PUBLIC_TOKEN_DECIMALS=18

# ---- Owner / treasury ------------------------------------------------------
# Owner tunes the config; the treasury receives 40% of every ship purchase and refit
# (the other 60% funds the reward vault). Treasury defaults to the owner.
NEXT_PUBLIC_OWNER_ADDRESS=
NEXT_PUBLIC_TREASURY_ADDRESS=

# ---- Randomness server -----------------------------------------------------
# The server signs a commitment before every launch and reveals the seed after the
# mission ends. Keep the key server-side only; its address is baked into the contract.
RANDOM_SIGNER_KEY=
NEXT_PUBLIC_RANDOM_SIGNER_ADDRESS=

# ---- Game contract ---------------------------------------------------------
# Predicted from the config (CREATE2) — set only to override, e.g. after a manual deploy.
NEXT_PUBLIC_GAME_ADDRESS=

# Public site URL (metadata, WalletConnect)
NEXT_PUBLIC_SITE_URL=http://localhost:3781
